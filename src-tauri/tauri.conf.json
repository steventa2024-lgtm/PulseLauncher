{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseLauncher",
  "version": "0.1.0",
  "identifier": "com.zeropulse.pulselauncher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PulseLauncher",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      },
      {
        "label": "launcher",
        "title": "PulseLauncher",
        "url": "index.html?view=launcher",
        "width": 720,
        "height": 540,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "ZeroPulse",
    "shortDescription": "Local Windows launcher and app hub",
    "longDescription": "PulseLauncher is a free, open-source, offline Windows launcher for installed and portable applications.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
