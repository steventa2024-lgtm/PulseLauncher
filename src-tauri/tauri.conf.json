{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseLauncher",
  "version": "0.1.0",
  "identifier": "com.zeropulse.pulselauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PulseLauncher",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#090D17"
      },
      {
        "label": "launcher",
        "title": "PulseLauncher Search",
        "url": "index.html?view=launcher",
        "width": 720,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ZeroPulse",
    "copyright": "Copyright (c) 2026 ZeroPulse. MIT License.",
    "category": "Productivity",
    "shortDescription": "Free, local-first Windows launcher and app hub",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
